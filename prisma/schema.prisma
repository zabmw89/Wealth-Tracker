//////////////////////////////////////////////////////////////////////////////////////////////

datasource db {
    provider = "postgresql"
    url = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

enum Role {
    OWNER
    EDITOR
    VIEWER
}

enum AssetType {
    STOCK
    CRYPTO
    REAL_ESTATE
    CASH
}

enum TxType {
    BUY
    SELL
    DEPOSIT
    WITHDRAW
}

enum Source {
    UI
    AGENT
}

model User {
    id String @id() @default(cuid())
    email String @unique()
    name String
    memberships Membership[]
}

model Portfolio {
    id String @id() @default(cuid())
    name String
    baseCurrency String @default("USD")
    createdAt DateTime @default(now())
    memberships Membership[]
    assets Asset[]
}

model Membership {
    id String @id() @default(cuid())
    role Role
    user User @relation(fields: [userId], references: [id])
    userId String
    portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
    portfolioId String

    @@unique([userId, portfolioId])
}

model Asset {
    id String @id() @default(cuid())
    type AssetType
    symbol String
    name String
    portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
    portfolioId String
    transactions Transaction[]

    @@unique([portfolioId, symbol])
}

model Transaction {
    id String @id() @default(cuid())
    type TxType
    quantity Decimal @db.Decimal(28, 10)
    price Decimal @db.Decimal(28, 10)
    fee Decimal @db.Decimal(28, 10) @default(0)
    date DateTime
    asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
    assetId String
    createdBy String
    createdAt DateTime @default(now())

    @@index([assetId, date])
}

model PriceSnapshot {
    id String @id() @default(cuid())
    symbol String
    price Decimal @db.Decimal(28, 10)
    asOf DateTime

    @@index([symbol, asOf])
}

model AuditLog {
    id String @id() @default(cuid())
    userId String
    portfolioId String
    source Source
    action String
    payload Json
    createdAt DateTime @default(now())
}